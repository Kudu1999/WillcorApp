<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WillcorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WillcorApp"
    xmlns:pages="clr-namespace:WillcorApp.Pages"
    Title="WillcorApp"
    Shell.TabBarUnselectedColor="grey"
    Shell.TabBarForegroundColor="{StaticResource WilDarkGreen}"
    Shell.TabBarTitleColor="{StaticResource WilDarkGreen}"
    Shell.TitleColor="{StaticResource WilDarkGreen}">

    <TabBar>
        <ShellContent Title="Today" 
          Icon="bakkie"
           ContentTemplate="{DataTemplate local:MainPage}"/>

        <ShellContent Title="Pickups"
          Icon="trash"
           ContentTemplate="{DataTemplate pages:PickupHistory}"/>

        <ShellContent Title="Calendar"
          Icon="clock"
           ContentTemplate="{DataTemplate pages:CalendarPage}"/>

        <ShellContent Title="Clients"
          Icon="user"
           ContentTemplate="{DataTemplate pages:ClientsPage}"/>
    </TabBar>


</Shell>
