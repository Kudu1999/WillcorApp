<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WillcorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WillcorApp"
    Title="WillcorApp"
    Shell.TabBarUnselectedColor="grey"
    Shell.TabBarForegroundColor="{StaticResource WilDarkGreen}"
    Shell.TabBarTitleColor="{StaticResource WilDarkGreen}">

    <TabBar>
        <ShellContent Title="Today" 
          Icon="bakkie"
           ContentTemplate="{DataTemplate local:MainPage}"/>

        <ShellContent Title="Pickups"
          Icon="trash"
           ContentTemplate="{DataTemplate local:MainPage}"/>

        <ShellContent Title="History"
          Icon="clock"
           ContentTemplate="{DataTemplate local:MainPage}"/>

        <ShellContent Title="Profile"
          Icon="user"
           ContentTemplate="{DataTemplate local:MainPage}"/>
    </TabBar>


</Shell>
