<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WillcorApp.Pages.ClientsPage"
             xmlns:local="clr-namespace:WillcorApp.Converters"
             Title="Clients">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:RadioButtonConverter x:Key="RadioButtonConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource BackgroundGray}">
        <Grid RowDefinitions="Auto, *, Auto" Padding="10" RowSpacing="10" IsVisible="True" x:Name="ClientListUI">

            <Border BackgroundColor="White" Stroke="LightGray">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <SearchBar Placeholder="Search" Text="{Binding SearchText}"/>
            </Border>

            <ActivityIndicator Grid.Row="1" Color="{StaticResource WilDarkGreen}" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center"/>

            <CollectionView ItemsSource="{Binding FilteredClientList}" Grid.Row="1" IsVisible="{Binding ShowContent}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,10,10,0">
                            <Border Padding="10" Stroke="{StaticResource WilBorderGreen}" BackgroundColor="White" Margin="0,15,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="0.5*, 0.5*">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="Medium"/>
                                    <Label Grid.Row="1" Grid.Column="0" Text="AREA CODE" TextColor="Gray" FontSize="Micro" Margin="0,10,0,0"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="REF NUMBER" TextColor="Gray" FontSize="Micro" Margin="0,10,0,0"/>
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceNumber}"/>
                                    <Label Grid.Row="2" Grid.Column="0" Text="{Binding AreaCode}"/>
                                    <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BackgroundGray}" Stroke="{StaticResource WilBorderGreen}" Margin="0,7,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5"/>
                                        </Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto, *" Padding="15,4,15,4">
                                            <Label Grid.Row="0" Text="$"/>
                                            <Label Grid.Column="1" Text="{Binding Address}"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BackgroundGray}" Margin="0,10,0,0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                    </Border>

                                    <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Margin="0,10,0,0" Text="Edit" Clicked="OpenEditClientUI" BackgroundColor="{StaticResource WilDarkGreen}" FontAttributes="Bold"/>

                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Grid.Row="2" Text="Add Client" Clicked="AddNewClient" BackgroundColor="{StaticResource WilDarkGreen}"/>

        </Grid>


        <ScrollView IsVisible="False" x:Name="AddNewClientUI">
            <VerticalStackLayout Padding="10">
                <Label Text="Name"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewClient.Name, Mode=TwoWay}"/>
                </Border>

                <Label Text="Address" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewClient.Address, Mode=TwoWay}"/>
                </Border>

                <Label Text="Area code" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewClient.AreaCode, Mode=TwoWay}"/>
                </Border>

                <Label Text="Reference number" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewClient.ReferenceNumber, Mode=TwoWay}"/>
                </Border>

                <Label Text="Notes" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding NewClient.Notes, Mode=TwoWay}"/>
                </Border>

                <Button x:Name="AddScheduleBTN" Text="Add schedule" Clicked="ShowSchedule" BackgroundColor="{StaticResource WilDarkGreen}" Margin="0,10,0,0"/>

                <VerticalStackLayout x:Name="ScheduleInputUI" IsVisible="False">
                    <Label Text="Select weekly interval" FontSize="Medium" FontAttributes="Bold" TextColor="{StaticResource WilDarkGreen}" Margin="0,15,0,0"/>

                    <BoxView HeightRequest="1" Color="LightGray" HorizontalOptions="Fill" Margin="0,10,0,10"/>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions=".5*, .5*">

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0">
                            <RadioButton 
                                    GroupName="Frequency"
                                    Value="Weekly"
                                    IsChecked="{Binding SelectedFrequency, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Weekly}" />
                            <Label Text="Weekly" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0">
                            <RadioButton 
                                    GroupName="Frequency"
                                    Value="Biweekly"
                                    IsChecked="{Binding SelectedFrequency, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=Biweekly}" />
                            <Label Text="Biweekly" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
                            <RadioButton 
                                    GroupName="Frequency"
                                    Value="OnCall"
                                    IsChecked="{Binding SelectedFrequency, Mode=TwoWay, Converter={StaticResource RadioButtonConverter}, ConverterParameter=OnCall}" />
                            <Label Text="On Call" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </Grid>

                    <Label Text="Select pick up days" FontSize="Medium" FontAttributes="Bold" TextColor="{StaticResource WilDarkGreen}" Margin="0,15,0,0"/>

                    <BoxView HeightRequest="1" Color="LightGray" HorizontalOptions="Fill" Margin="0,10,0,10"/>

                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions=".5*, .5*">
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" >
                            <CheckBox IsChecked="{Binding IsMondaychecked, Mode=TwoWay}"/>
                            <Label Text="Moday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0">
                            <CheckBox IsChecked="{Binding IsTuesdaychecked, Mode=TwoWay}"/>
                            <Label Text="Tuesday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0">
                            <CheckBox IsChecked="{Binding IsWednesdaychecked, Mode=TwoWay}"/>
                            <Label Text="Wednesday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="3" Grid.Column="0">
                            <CheckBox IsChecked="{Binding IsThursdaychecked, Mode=TwoWay}"/>
                            <Label Text="Thursday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1">
                            <CheckBox IsChecked="{Binding IsFridaychecked, Mode=TwoWay}"/>
                            <Label Text="Friday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1">
                            <CheckBox IsChecked="{Binding IsSaturdaychecked, Mode=TwoWay}"/>
                            <Label Text="Saturday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="2" Grid.Column="1">
                            <CheckBox IsChecked="{Binding IsSundaychecked, Mode=TwoWay}"/>
                            <Label Text="Sunday" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <Button x:Name="CloseScheduleBTN" Text="Close schedule" Clicked="CloseSchedule" IsVisible="false" BackgroundColor="White" TextColor="Gray" BorderColor="Gray" Margin="0,10,0,0"/>

                </VerticalStackLayout>



                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions=".8*, .2*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Clicked="SaveNewClient"  Text="Save" TextColor="White" BackgroundColor="{StaticResource WilDarkGreen}" Padding="10" />
                    <Button Grid.Column="1" Clicked="CloseNewClient" Text="Cancel"  BackgroundColor="White" TextColor="Gray" Padding="10" BorderColor="Gray"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <ScrollView IsVisible="False" x:Name="EditClientUI">
            <VerticalStackLayout Padding="10">
                <Label Text="Name"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding SelectedClient.Name, Mode=TwoWay}"/>
                </Border>

                <Label Text="Address" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding SelectedClient.Address, Mode=TwoWay}"/>
                </Border>

                <Label Text="Area code" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding SelectedClient.AreaCode, Mode=TwoWay}"/>
                </Border>

                <Label Text="Reference number" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding SelectedClient.ReferenceNumber, Mode=TwoWay}"/>
                </Border>

                <Label Text="Notes" Margin="0,10,0,0"/>
                <Border BackgroundColor="White" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding SelectedClient.Notes, Mode=TwoWay}"/>
                </Border>

                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions=".8*, .2*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Clicked="EditClient"  Text="Save" TextColor="White" BackgroundColor="{StaticResource WilDarkGreen}" Padding="10" />
                    <Button Grid.Column="1" Clicked="CloseEditClientUI" Text="Cancel"  BackgroundColor="White" TextColor="Gray" Padding="10" BorderColor="Gray"/>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>