<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WillcorApp.Pages.PickupHistory"
             Title="PickupHistory"
             BackgroundColor="{StaticResource BackgroundGray}">

    <Grid>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" VerticalOptions="Center" HorizontalOptions="Center"/>

        <CollectionView ItemsSource="{Binding PickupRunItems}" IsVisible="{Binding ShowContent}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,10,10,0">
                        <Border Padding="10" Stroke="{StaticResource WilBorderGreen}" BackgroundColor="White" Margin="0,15,0,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="0.5*, 0.5*">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding ClientName}" FontAttributes="Bold" FontSize="Medium"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding CollectedAt, StringFormat='{0:hh:mm - ddd, d MMM}'}"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="AREA CODE" TextColor="Gray" FontSize="Micro" Margin="0,10,0,0"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="REF NUMBER" TextColor="Gray" FontSize="Micro" Margin="0,10,0,0"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceNumber}"/>
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding AreaCode}"/>
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BackgroundGray}" Stroke="{StaticResource WilBorderGreen}" Margin="0,7,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="5"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto, *" Padding="15,4,15,4">
                                        <Label Grid.Row="0" Text="$"/>
                                        <Label Grid.Column="1" Text="{Binding Address}"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="{StaticResource BackgroundGray}" Margin="0,10,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions=".3*,.3*,.3*" RowDefinitions="auto, auto">
                                        <Label Grid.Column="0" Grid.Row="0" Text="Small bags" HorizontalOptions="Center"/>
                                        <Label Grid.Column="1" Grid.Row="0" Text="Big bags" HorizontalOptions="Center"/>
                                        <Label Grid.Column="2" Grid.Row="0" Text="Trailer loads" HorizontalOptions="Center"/>
                                        <Label Grid.Column="0" Grid.Row="1" Text="{Binding SmallBagsCollected}" FontSize="Large" HorizontalOptions="Center"/>
                                        <Label Grid.Column="1" Grid.Row="1" Text="{Binding BigBagsCollected}" FontSize="Large" HorizontalOptions="Center"/>
                                        <Label Grid.Column="2" Grid.Row="1" Text="{Binding TrailerLoadsCollected}" FontSize="Large" HorizontalOptions="Center"/>
                                    </Grid>

                                </Border>

                                <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" Margin="0,10,0,0" Text="Edit" BackgroundColor="{StaticResource WilDarkGreen}" FontAttributes="Bold" Clicked="Editbutton_Clicked"/>

                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="2" BackgroundColor="White" Padding="20" IsVisible="False" x:Name="pickupPopup" ZIndex="10" VerticalOptions="End">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20, 20,0,0"/>
            </Border.StrokeShape>
            <VerticalStackLayout>
                <Label x:Name="PickupClientName" Text="" FontSize="Medium"/>
                <Label Text="Log the bags collected for this pickup" TextColor="Gray" FontSize="Small"/>
                <Grid ColumnDefinitions="0.3*,0.3*,0.3*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Border Grid.Column="0"  Padding="5" BackgroundColor="#F6FAF6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Small Bags" HorizontalOptions="Center" TextColor="Gray" Margin="2" />
                            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                <Button Text="-" Clicked="Subsmallbag" Style="{StaticResource addButton}" />
                                <Label Text="0" x:Name="smallbagstxt" VerticalOptions="Center"/>
                                <Button Text="+" Clicked="Addsmallbag" Style="{StaticResource addButton}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"  Padding="5" BackgroundColor="#F6FAF6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Big Bags" HorizontalOptions="Center" TextColor="Gray" Margin="2"/>
                            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                <Button Text="-" Clicked="SubBigbag" Style="{StaticResource addButton}" />
                                <Label Text="0" x:Name="bigbagstxt" VerticalOptions="Center"/>
                                <Button Text="+" Clicked="AddBigbag" Style="{StaticResource addButton}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2"  Padding="5" BackgroundColor="#F6FAF6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Trailer loads" HorizontalOptions="Center" TextColor="Gray" Margin="2"/>
                            <HorizontalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                <Button Text="-" Clicked="SubTrailer" Style="{StaticResource addButton}" />
                                <Label Text="0" x:Name="trailerloadstxt" VerticalOptions="Center"/>
                                <Button Text="+" Clicked="AddTrailer" Style="{StaticResource addButton}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Label Text="Comment (Optional)" TextColor="Gray" Margin="0,10,0,0"/>
                <Border BackgroundColor="#F6FAF6" Padding="5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Editor Placeholder="e.g Gate was loacked" AutoSize="TextChanges" HeightRequest="100" x:Name="pickupNotes" />
                </Border>
                <Grid ColumnDefinitions="0.4*, 0.6*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Cancel" Clicked="CancelEditPickupClicked" BackgroundColor="White" TextColor="Black" BorderColor="Gray"/>
                    <Button Grid.Column="1" Text="Confirm pickup" Clicked="ConfirmEditPickupClicked" BackgroundColor="{StaticResource WilDarkGreen}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>


</ContentPage>